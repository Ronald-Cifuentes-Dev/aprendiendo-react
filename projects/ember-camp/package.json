{
  "name": "ember-camp-nextjs",
  "version": "1.0.0",
  "private": true,
  "engines": {"node": ">=20.9.0"},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:data": "node scripts/verify-data.mjs",
    "verify": "npm run verify:data && npm run typecheck && npm run build",
    "verify:full": "npm run verify && node scripts/smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}